# Copy this file to .env and fill in real secrets before running docker compose.
# Every value here has a sane local-dev default baked into docker-compose.yml except
# the two JWT secrets, which are required.

# --- Core ---
FRONTEND_URL=http://localhost:4200
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# --- Database (Postgres by default; see docker-compose.mysql.yml to swap to MySQL) ---
DB_DIALECT=postgres
DB_NAME=helpdesk
DB_USER=helpdesk
DB_PASSWORD=helpdesk
# DB_ROOT_PASSWORD is only used by the MySQL compose override
DB_ROOT_PASSWORD=helpdesk_root

# --- Auth provider: local (built-in users table) or ldap (bind against AD/OpenLDAP) ---
AUTH_PROVIDER=local
LDAP_URL=ldaps://ad.example.com
LDAP_BIND_DN=CN=svc-helpdesk,OU=Service Accounts,DC=corp,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=OU=Users,DC=corp,DC=local
LDAP_SEARCH_FILTER=(|(sAMAccountName={{username}})(uid={{username}})(mail={{username}}))
# JSON map of LDAP group DN -> app role (admin | technician | customer)
LDAP_GROUP_ROLE_MAP={"CN=Helpdesk Admins,OU=Groups,DC=corp,DC=local":"admin","CN=IT Techs,OU=Groups,DC=corp,DC=local":"technician"}
LDAP_DEFAULT_ROLE=customer

# --- File storage: local (docker volume) or s3 (AWS S3 / MinIO / Spaces / Backblaze / Wasabi) ---
STORAGE_DRIVER=local
S3_BUCKET=helpdesk-files
S3_REGION=us-east-1
# Point at MinIO for local dev, or omit for real AWS S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=helpdesk
S3_SECRET_ACCESS_KEY=helpdesk123
S3_FORCE_PATH_STYLE=true

# --- Outbound email (SMTP; Mailhog in local dev, point at your real relay in production) ---
EMAIL_FROM=helpdesk@example.com

# --- Inbound email-to-ticket gateway (optional, off by default) ---
EMAIL_INBOUND_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- First-run admin account seeding ---
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Log monitoring (Module 3) ---
# Off by default - enable only if you want to point network gear/servers at this host's
# syslog port directly, in addition to (or instead of) the HTTP ingestion API.
LOG_SYSLOG_ENABLED=false
LOG_RETENTION_SWEEP_INTERVAL_MS=3600000
ALERT_EVALUATION_INTERVAL_MS=30000

# --- Host port overrides (only needed if a default port is already taken on your machine) ---
# DB_HOST_PORT=5432
# BACKEND_PORT=4000
# FRONTEND_PORT=4200
# MAILHOG_WEB_PORT=8025
# MAILHOG_SMTP_PORT=1025
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# SYSLOG_UDP_PORT=514
