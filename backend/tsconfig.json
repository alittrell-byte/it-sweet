{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    // Pin ambient @types explicitly: in this npm workspaces monorepo, the frontend's
    // @types/jasmine hoists into the shared root node_modules/@types and would
    // otherwise leak into the backend's TS program, clobbering Jest's global `expect`.
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
