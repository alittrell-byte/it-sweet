{{ ansible_managed | comment }}
# --- Core ---
FRONTEND_URL=https://{{ helpdesk_domain }}
JWT_ACCESS_SECRET={{ jwt_access_secret }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret }}

# --- Database ---
DB_DIALECT={{ db_dialect }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}

# --- Auth provider ---
AUTH_PROVIDER={{ auth_provider }}

# --- File storage ---
STORAGE_DRIVER={{ storage_driver }}

# --- Outbound email ---
EMAIL_FROM={{ email_from }}

# --- First-run admin account seeding ---
SEED_ON_START=true
SEED_ADMIN_EMAIL={{ seed_admin_email }}
SEED_ADMIN_PASSWORD={{ seed_admin_password }}

# --- Host port overrides (only set if the default is already taken on the target) ---
{% if frontend_port is defined %}
FRONTEND_PORT={{ frontend_port }}
{% endif %}
{% if backend_port is defined %}
BACKEND_PORT={{ backend_port }}
{% endif %}
{% if db_host_port is defined %}
DB_HOST_PORT={{ db_host_port }}
{% endif %}
{% if minio_api_port is defined %}
MINIO_API_PORT={{ minio_api_port }}
{% endif %}
{% if minio_console_port is defined %}
MINIO_CONSOLE_PORT={{ minio_console_port }}
{% endif %}
{% if mailhog_web_port is defined %}
MAILHOG_WEB_PORT={{ mailhog_web_port }}
{% endif %}
{% if mailhog_smtp_port is defined %}
MAILHOG_SMTP_PORT={{ mailhog_smtp_port }}
{% endif %}
{% if syslog_udp_port is defined %}
SYSLOG_UDP_PORT={{ syslog_udp_port }}
{% endif %}
